# AV OS private access (set these in Netlify Environment Variables)
AVOS_ACCESS_EMAIL=
AVOS_ACCESS_CODE=
AVOS_SESSION_SECRET=

# Optional: GitHub API higher rate limit for AV OS observability
GITHUB_TOKEN=

# Optional: AV OS Data Hub (dedicated Supabase project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AVOS_INGEST_KEY=

# AV Document Intelligence
# Service-to-service authentication. Keep secret; never expose in browser code.
AV_DOCUMENT_INTELLIGENCE_KEY=
# internal = text extraction built into AV; external = OCR/Document AI adapter; mock = tests only
AV_DOCUMENT_INTELLIGENCE_PROVIDER=internal
AV_DOCUMENT_ALLOW_MOCK=false
# Optional external provider adapter for image/PDF/OCR. The endpoint must accept the AV payload contract.
AV_DOCUMENT_PROVIDER_URL=
AV_DOCUMENT_PROVIDER_TOKEN=
